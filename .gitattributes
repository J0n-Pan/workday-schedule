# Normalize text files to LF in the repo, CRLF in the working tree on Windows.
* text=auto eol=lf

# Windows scripts MUST keep CRLF line endings (VBScript host rejects some LF cases).
*.vbs text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must keep LF.
*.sh text eol=lf

# Binaries
*.png binary
*.ico binary
*.db binary
